version: "3.8"

services:
  # Postgres DB for voting app
  db:
    image: postgres:15-alpine
    environment:
      POSTGRES_USER: "postgres"
      POSTGRES_PASSWORD: "postgres"
      POSTGRES_DB: "postgres"
    volumes:
      - db-data:/var/lib/postgresql/data
    networks:
      - back-tier
      - wazuh-net

  # Redis for voting app
  redis:
    image: redis:7-alpine
    ports:
      - "6379:6379"
    networks:
      - back-tier
      - wazuh-net

  # Vote web app
  vote:
    build: ./vote
    ports:
      - "5080:80"
    environment:
      OPTION_A: "Cats"
      OPTION_B: "Dogs"
      REDIS_HOST: "redis"
      REDIS_PORT: 6379
    networks:
      - front-tier
      - back-tier
      - wazuh-net

  # Result web app
  result:
    build: ./result
    ports:
      - "5001:80"
    environment:
      REDIS_HOST: "redis"
      REDIS_PORT: 6379
    networks:
      - front-tier
      - back-tier
      - wazuh-net

  # Worker
  worker:
    build: ./worker
    environment:
      REDIS_HOST: "redis"
      REDIS_PORT: 6379
    networks:
      - back-tier
      - wazuh-net

  # Wazuh Agent for Vote service
  wazuh-agent-vote:
    image: wazuh/wazuh-agent:4.7.2
    hostname: wazuh-agent-vote
    environment:
      - WAZUH_MANAGER=wazuh-manager
      - WAZUH_AGENT_NAME=vote-app
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
    networks:
      - wazuh-net
    depends_on:
      - wazuh-manager

  # Wazuh Agent for Result service
  wazuh-agent-result:
    image: wazuh/wazuh-agent:4.7.2
    hostname: wazuh-agent-result
    environment:
      - WAZUH_MANAGER=wazuh-manager
      - WAZUH_AGENT_NAME=result-app
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
    networks:
      - wazuh-net
    depends_on:
      - wazuh-manager

networks:
  front-tier:
  back-tier:
  wazuh-net:
    external: true
    name: voting-app_wazuh-net

volumes:
  db-data:
